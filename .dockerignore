# Only application build inputs enter the context.
**
!package.json
!package-lock.json
!tsconfig.json
!apps/
!apps/server/
!apps/server/**
!apps/web/
!apps/web/**
!packages/
!packages/shared/
!packages/shared/**

# Never send local configuration, secrets, generated files, or local databases.
**/.env*
**/.npmrc
**/.aws
**/.ssh
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/node_modules
apps/server/test
**/dist
**/coverage
**/*.tsbuildinfo
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/.git
**/.gitignore
**/.agents
**/.codex
**/skills
**/docs
**/reports
**/*.md
**/*.py
**/*.pyc
**/__pycache__
**/.venv
**/venv
**/.DS_Store
