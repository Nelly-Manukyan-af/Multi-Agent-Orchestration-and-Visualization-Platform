# Only application build inputs enter the context.
**
!package.json
!package-lock.json
!tsconfig.json
!apps/
!apps/server/
!apps/server/**
!apps/web/
!apps/web/**
!packages/
!packages/shared/
!packages/shared/**

# Exclude local configuration, secrets and generated files from allowed directories.
**/.env*
**/.npmrc
**/.aws
**/.ssh
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/node_modules
apps/server/test
**/dist
**/coverage
**/*.tsbuildinfo
**/.git
**/.gitignore
**/.agents
**/.codex
**/skills
**/docs
**/reports
**/*.md
**/.DS_Store
